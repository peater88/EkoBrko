# Zkopírujte na Vercel → Settings → Environment Variables (Production / Preview podle potřeby).
# SMTP Wedos – přesný host (wesX-smtp.wedos.net) najdete v dokumentaci / nastavení schránky.

SMTP_HOST=wes1-smtp.wedos.net
SMTP_PORT=587
# Pro port 465 nastavte SMTP_SECURE=true
SMTP_SECURE=false
SMTP_USER=info@ekobrko.cz
SMTP_PASS=

# Tajný řetězec min. ~24 znaků (náhodný); slouží k podepisování matematické úlohy.
CONTACT_SECRET=

CONTACT_TO=info@ekobrko.cz
# Volitelně jiná „From“ adresa (musí být povolená u Wedosu); výchozí je SMTP_USER.
# CONTACT_FROM=info@ekobrko.cz
